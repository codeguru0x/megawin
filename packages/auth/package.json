{
  "name": "@megawin/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authentication & authorization middleware for API Gateway Lambda",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tenant": {
      "types": "./src/tenant/index.ts",
      "default": "./dist/tenant/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/identity": "workspace:*",
    "@megawin/identity-application": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@middy/core": "^7.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.2.3",
    "typescript": "5.9.3"
  }
}
