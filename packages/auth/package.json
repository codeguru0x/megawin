{
  "name": "@megawin/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authentication & authorization middleware for API Gateway Lambda",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/auth^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tenant": {
      "types": "./src/tenant/index.ts",
      "import": "./src/tenant/index.ts",
      "default": "./dist/tenant/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/guard": "workspace:*",
    "@megawin/identity": "workspace:*",
    "@megawin/identity-application": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@middy/core": "^7.7.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@megawin/cache": "workspace:*",
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
