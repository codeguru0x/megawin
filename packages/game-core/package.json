{
  "name": "@megawin/game-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared game domain – unified entry status, change sequence, entry feed (internal only)",
  "scripts": {
    "dev": "tsc -b --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./entities/*": {
      "types": "./src/entities/*.ts",
      "import": "./src/entities/*.ts",
      "default": "./dist/entities/*.js"
    },
    "./indexes": {
      "types": "./src/indexes/index.ts",
      "import": "./src/indexes/index.ts",
      "default": "./dist/indexes/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./labels": {
      "types": "./src/labels/index.ts",
      "import": "./src/labels/index.ts",
      "default": "./dist/labels/index.js"
    }
  },
  "keywords": [
    "megawin",
    "game-core",
    "domain"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@megawin/shared": "workspace:*",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "6.0.2"
  }
}
