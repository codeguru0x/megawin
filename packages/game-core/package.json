{
  "name": "@megawin/game-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared game domain – unified entry status, change sequence, entry feed (internal only)",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc"
  },
  "exports": {
    "./entities": {
      "types": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./entities/*": {
      "types": "./src/entities/*.ts",
      "default": "./dist/entities/*.js"
    },
    "./indexes": {
      "types": "./src/indexes/index.ts",
      "default": "./dist/indexes/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "keywords": [
    "megawin",
    "game-core",
    "domain"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3"
  }
}
