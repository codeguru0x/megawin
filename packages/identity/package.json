{
  "name": "@megawin/identity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Identity domain – account, tenant, cognito entities (internal only)",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run"
  },
  "exports": {
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    }
  },
  "keywords": [
    "megawin",
    "identity",
    "domain"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
