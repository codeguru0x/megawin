{
  "name": "@megawin/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "default": "./dist/constants/index.js"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "import": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "./mappers": {
      "types": "./src/mappers/index.ts",
      "import": "./src/mappers/index.ts",
      "default": "./dist/mappers/index.js"
    },
    "./mappers/*": {
      "types": "./src/mappers/*.ts",
      "import": "./src/mappers/*.ts",
      "default": "./dist/mappers/*.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "./api-types": {
      "types": "./src/api-types/index.ts",
      "import": "./src/api-types/index.ts",
      "default": "./dist/api-types/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    }
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0"
  }
}
