{
  "name": "@megawin/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "./mappers/*": {
      "types": "./src/mappers/*.ts",
      "default": "./dist/mappers/*.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "./api-types": {
      "types": "./src/api-types/index.ts",
      "default": "./dist/api-types/index.js"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    }
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3",
    "vitest": "latest"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "date-fns": "^4.1.0",
    "ulid": "^3.0.2"
  }
}
