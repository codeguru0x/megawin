{
  "name": "@megawin/player-sdk",
  "version": "1.0.1",
  "description": "MegaWin Player SDK – HTTP client + game types cho đối tác tích hợp",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./keno": {
      "import": {
        "types": "./dist/keno.d.ts",
        "default": "./dist/keno.js"
      },
      "require": {
        "types": "./dist/keno.d.cts",
        "default": "./dist/keno.cjs"
      }
    },
    "./lotto535": {
      "import": {
        "types": "./dist/lotto535.d.ts",
        "default": "./dist/lotto535.js"
      },
      "require": {
        "types": "./dist/lotto535.d.cts",
        "default": "./dist/lotto535.cjs"
      }
    },
    "./browser": "./dist/megawin-player-sdk-browser.global.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "docs:build": "rm -rf docs && typedoc",
    "docs:watch": "typedoc --watch",
    "release": "pnpm build && pnpm docs:build && mkdir -p release && pnpm pack --pack-gzip-level 9 --pack-destination release && gzip -9 -k dist/megawin-player-sdk-browser.global.js && mv dist/megawin-player-sdk-browser.global.js.gz release/megawin-player-sdk-browser.js.gz",
    "upload": "bash scripts/upload-s3.sh patch",
    "upload:patch": "bash scripts/upload-s3.sh patch",
    "upload:minor": "bash scripts/upload-s3.sh minor",
    "upload:major": "bash scripts/upload-s3.sh major"
  },
  "keywords": [
    "megawin",
    "sdk",
    "player"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.17",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
