{
  "name": "@megawin/game-max3d-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Core application layer for Max 3D family – abstract repos, mappers, domain logic",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "default": "./dist/repos/index.js"
    },
    "./mappers": {
      "types": "./src/infras/mappers/index.ts",
      "default": "./dist/mappers/index.js"
    }
  },
  "dependencies": {
    "@megawin/data": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/game-core-application": "workspace:*",
    "@megawin/shared": "workspace:*",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3"
  }
}
