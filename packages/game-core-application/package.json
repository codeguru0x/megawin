{
  "name": "@megawin/game-core-application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Game core application layer – repos, mappers, use-cases for entry feed, change sequence & daily reports",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/game-core-application^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "import": "./src/infras/repos/index.ts",
      "default": "./dist/infras/repos/index.js"
    },
    "./mappers": {
      "types": "./src/infras/mappers/index.ts",
      "import": "./src/infras/mappers/index.ts",
      "default": "./dist/infras/mappers/index.js"
    },
    "./use-cases": {
      "types": "./src/use-cases/index.ts",
      "import": "./src/use-cases/index.ts",
      "default": "./dist/use-cases/index.js"
    },
    "./use-cases/reports": {
      "types": "./src/use-cases/reports/index.ts",
      "import": "./src/use-cases/reports/index.ts",
      "default": "./dist/use-cases/reports/index.js"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "next": "^16.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
