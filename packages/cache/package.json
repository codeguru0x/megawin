{
  "name": "@megawin/cache",
  "version": "1.0.0",
  "description": "Layered cache (L1 memory + L2 Redis) — interface-first, fail-open, backend-agnostic",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["megawin", "cache", "redis", "lru"],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./stores": {
      "types": "./src/stores/index.ts",
      "import": "./src/stores/index.ts",
      "default": "./dist/stores/index.js"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "import": "./src/redis/index.ts",
      "default": "./dist/redis/index.js"
    }
  },
  "dependencies": {
    "@megawin/shared": "workspace:*",
    "lru-cache": "^11.5.2",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
