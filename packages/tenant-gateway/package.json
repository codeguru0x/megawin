{
  "name": "@megawin/tenant-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "Outbound HTTP client to call tenant server APIs (debit, credit, balance, report)",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "megawin",
    "tenant",
    "gateway",
    "outbound"
  ],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@megawin/http-client": "workspace:*",
    "@megawin/shared": "workspace:*"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "6.0.2"
  }
}
