{
  "name": "@megawin/tenant-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "Outbound HTTP client to call tenant server APIs (debit, credit, balance, report)",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "docs:preview": "redocly preview-docs openapi.yaml",
    "docs:lint": "redocly lint openapi.yaml",
    "docs:build": "rm -rf docs && redocly build-docs openapi.yaml -o docs/index.html"
  },
  "keywords": [
    "megawin",
    "tenant",
    "gateway",
    "outbound"
  ],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./use-cases/tx-logs": {
      "types": "./src/use-cases/tx-logs/index.ts",
      "import": "./src/use-cases/tx-logs/index.ts",
      "default": "./dist/use-cases/tx-logs/index.js"
    },
    "./shared/labels": {
      "types": "./src/shared/labels/index.ts",
      "import": "./src/shared/labels/index.ts",
      "default": "./dist/shared/labels/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/http-client": "workspace:*",
    "@megawin/identity": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "lru-cache": "^11.3.3",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@redocly/cli": "^2.26.0",
    "@types/node": "^25.5.0",
    "typescript": "6.0.2"
  }
}
