{
  "name": "@megawin/identity-domain",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/accounts/index.ts",
      "default": "./dist/accounts/index.js"
    },
    "./accounts": {
      "types": "./src/accounts/index.ts",
      "default": "./dist/accounts/index.js"
    },
    "./accounts/*": {
      "types": "./src/accounts/*.ts",
      "default": "./dist/accounts/*.js"
    },
    "./tenants": {
      "types": "./src/tenants/index.ts",
      "default": "./dist/tenants/index.js"
    },
    "./tenants/*": {
      "types": "./src/tenants/*.ts",
      "default": "./dist/tenants/*.js"
    },
    "./cognito": {
      "types": "./src/cognito/index.ts",
      "default": "./dist/cognito/index.js"
    },
    "./cognito/*": {
      "types": "./src/cognito/*.ts",
      "default": "./dist/cognito/*.js"
    }
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3"
  }
}
