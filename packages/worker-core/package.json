{
  "name": "@megawin/worker-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared infrastructure cho workers — distributed lock, checkpoint, kill-switch dựa trên MongoDB. Subpath exports: ./workers (SingleRunWorker, TickLoopWorker) và ./locks (DistributedMutex).",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/worker-core^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "import": "./src/infras/repos/index.ts",
      "default": "./dist/infras/repos/index.js"
    },
    "./use-cases": {
      "types": "./src/use-cases/index.ts",
      "import": "./src/use-cases/index.ts",
      "default": "./dist/use-cases/index.js"
    },
    "./workers": {
      "types": "./src/use-cases/lock/workers.ts",
      "import": "./src/use-cases/lock/workers.ts",
      "default": "./dist/use-cases/lock/workers.js"
    },
    "./locks": {
      "types": "./src/use-cases/lock/locks.ts",
      "import": "./src/use-cases/lock/locks.ts",
      "default": "./dist/use-cases/lock/locks.js"
    },
    "./indexes": {
      "types": "./src/indexes/index.ts",
      "import": "./src/indexes/index.ts",
      "default": "./dist/indexes/index.js"
    },
    "./use-cases/admin": {
      "types": "./src/use-cases/admin/index.ts",
      "import": "./src/use-cases/admin/index.ts",
      "default": "./dist/use-cases/admin/index.js"
    },
    "./use-cases/admin/types": {
      "types": "./src/use-cases/admin/types.ts",
      "import": "./src/use-cases/admin/types.ts",
      "default": "./dist/use-cases/admin/types.js"
    },
    "./use-cases/health": {
      "types": "./src/use-cases/health/index.ts",
      "import": "./src/use-cases/health/index.ts",
      "default": "./dist/use-cases/health/index.js"
    },
    "./shared/labels": {
      "types": "./src/shared/labels/index.ts",
      "import": "./src/shared/labels/index.ts",
      "default": "./dist/shared/labels/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/audit": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
