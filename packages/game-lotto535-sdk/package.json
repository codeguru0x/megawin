{
  "name": "@megawin/game-lotto535-sdk",
  "version": "1.0.0",
  "description": "Lotto 5/35 public types – safe to expose for tenant SDK development",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit"
  },
  "keywords": ["megawin", "lotto535", "sdk", "types"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
