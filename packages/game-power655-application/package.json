{
  "name": "@megawin/game-power655-application",
  "version": "1.0.0",
  "private": true,
  "description": "Power 6/55 application layer – repos, mappers, use cases",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/game-power655-application^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "default": "./dist/infras/repos/index.js"
    },
    "./mappers": {
      "types": "./src/infras/mappers/index.ts",
      "default": "./dist/infras/mappers/index.js"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "default": "./dist/helpers/index.js"
    },
    "./use-cases/draws": {
      "types": "./src/use-cases/draws/index.ts",
      "default": "./dist/use-cases/draws/index.js"
    },
    "./use-cases/place-bet": {
      "types": "./src/use-cases/place-bet/index.ts",
      "default": "./dist/use-cases/place-bet/index.js"
    },
    "./use-cases/game-config": {
      "types": "./src/use-cases/game-config/index.ts",
      "default": "./dist/use-cases/game-config/index.js"
    },
    "./use-cases/tenant-config": {
      "types": "./src/use-cases/tenant-config/index.ts",
      "default": "./dist/use-cases/tenant-config/index.js"
    },
    "./use-cases/settle": {
      "types": "./src/use-cases/settle/index.ts",
      "default": "./dist/use-cases/settle/index.js"
    },
    "./use-cases/jackpot": {
      "types": "./src/use-cases/jackpot/index.ts",
      "default": "./dist/use-cases/jackpot/index.js"
    },
    "./use-cases/payout": {
      "types": "./src/use-cases/payout/index.ts",
      "default": "./dist/use-cases/payout/index.js"
    },
    "./use-cases/void": {
      "types": "./src/use-cases/void/index.ts",
      "default": "./dist/use-cases/void/index.js"
    },
    "./use-cases/feed": {
      "types": "./src/use-cases/feed/index.ts",
      "default": "./dist/use-cases/feed/index.js"
    },
    "./use-cases/player": {
      "types": "./src/use-cases/player/index.ts",
      "default": "./dist/use-cases/player/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/game-core-application": "workspace:*",
    "@megawin/game-power655": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.2.1",
    "next": "^16.1.6",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
