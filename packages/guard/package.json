{
  "name": "@megawin/guard",
  "version": "1.0.0",
  "description": "Rate limiting (GCRA) + idempotency primitives — fail-open defense layer",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "keywords": [
    "megawin",
    "guard",
    "rate-limit",
    "gcra",
    "idempotency"
  ],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./rate-limit": {
      "types": "./src/rate-limit/index.ts",
      "import": "./src/rate-limit/index.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./middleware": {
      "types": "./src/middleware/index.ts",
      "import": "./src/middleware/index.ts",
      "default": "./dist/middleware/index.js"
    }
  },
  "dependencies": {
    "@megawin/cache": "workspace:*",
    "@megawin/shared": "workspace:*"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
