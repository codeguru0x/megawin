{
  "name": "@megawin/game-lotto535",
  "version": "1.0.0",
  "private": true,
  "description": "Lotto 5/35 game domain – entities, rules, helpers (internal only)",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc"
  },
  "exports": {
    "./entities": {
      "types": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./entities/*": {
      "types": "./src/entities/*.ts",
      "default": "./dist/entities/*.js"
    },
    "./rules": {
      "types": "./src/rules/index.ts",
      "default": "./dist/rules/index.js"
    },
    "./rules/*": {
      "types": "./src/rules/*.ts",
      "default": "./dist/rules/*.js"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "default": "./dist/helpers/index.js"
    },
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./dist/helpers/*.js"
    },
    "./indexes": {
      "types": "./src/indexes/index.ts",
      "default": "./dist/indexes/index.js"
    }
  },
  "keywords": ["megawin", "lotto535", "game", "domain"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@megawin/game-core": "workspace:*"
  }
}
