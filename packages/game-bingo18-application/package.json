{
  "name": "@megawin/game-bingo18-application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bingo 18 application layer – repos, mappers, use cases",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/game-bingo18-application^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./use-cases/place-bet": {
      "types": "./src/use-cases/place-bet/index.ts",
      "import": "./src/use-cases/place-bet/index.ts",
      "default": "./dist/use-cases/place-bet/index.js"
    },
    "./use-cases/settle": {
      "types": "./src/use-cases/settle/index.ts",
      "import": "./src/use-cases/settle/index.ts",
      "default": "./dist/use-cases/settle/index.js"
    },
    "./use-cases/void": {
      "types": "./src/use-cases/void/index.ts",
      "import": "./src/use-cases/void/index.ts",
      "default": "./dist/use-cases/void/index.js"
    },
    "./use-cases/feed": {
      "types": "./src/use-cases/feed/index.ts",
      "import": "./src/use-cases/feed/index.ts",
      "default": "./dist/use-cases/feed/index.js"
    },
    "./use-cases/draws": {
      "types": "./src/use-cases/draws/index.ts",
      "import": "./src/use-cases/draws/index.ts",
      "default": "./dist/use-cases/draws/index.js"
    },
    "./use-cases/resettle": {
      "types": "./src/use-cases/resettle/index.ts",
      "import": "./src/use-cases/resettle/index.ts",
      "default": "./dist/use-cases/resettle/index.js"
    },
    "./use-cases/game-config": {
      "types": "./src/use-cases/game-config/index.ts",
      "import": "./src/use-cases/game-config/index.ts",
      "default": "./dist/use-cases/game-config/index.js"
    },
    "./use-cases/tenant-config": {
      "types": "./src/use-cases/tenant-config/index.ts",
      "import": "./src/use-cases/tenant-config/index.ts",
      "default": "./dist/use-cases/tenant-config/index.js"
    },
    "./use-cases/player": {
      "types": "./src/use-cases/player/index.ts",
      "import": "./src/use-cases/player/index.ts",
      "default": "./dist/use-cases/player/index.js"
    },
    "./use-cases/operations": {
      "types": "./src/use-cases/operations/index.ts",
      "import": "./src/use-cases/operations/index.ts",
      "default": "./dist/use-cases/operations/index.js"
    },
    "./use-cases/reports": {
      "types": "./src/use-cases/reports/index.ts",
      "import": "./src/use-cases/reports/index.ts",
      "default": "./dist/use-cases/reports/index.js"
    },
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "import": "./src/infras/repos/index.ts",
      "default": "./dist/infras/repos/index.js"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    }
  },
  "keywords": [
    "megawin",
    "bingo18",
    "game",
    "application"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/game-bingo18": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/game-core-application": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@megawin/tenant-dispatch": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "@megawin/worker-core": "workspace:*",
    "mongodb": "^7.3.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "^4.1.9"
  }
}
