{
  "name": "@megawin/app-core",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    "./use-cases": {
      "types": "./src/use-cases/index.ts",
      "import": "./src/use-cases/index.ts",
      "default": "./dist/use-cases/index.js"
    },
    "./aws": {
      "types": "./src/aws/index.ts",
      "import": "./src/aws/index.ts",
      "default": "./dist/aws/index.js"
    },
    "./aws/cognito": {
      "types": "./src/aws/cognito/index.ts",
      "import": "./src/aws/cognito/index.ts",
      "default": "./dist/aws/cognito/index.js"
    },
    "./aws/kinesis": {
      "types": "./src/aws/kinesis/index.ts",
      "import": "./src/aws/kinesis/index.ts",
      "default": "./dist/aws/kinesis/index.js"
    },
    "./aws/sqs": {
      "types": "./src/aws/sqs/index.ts",
      "import": "./src/aws/sqs/index.ts",
      "default": "./dist/aws/sqs/index.js"
    },
    "./aws/sf": {
      "types": "./src/aws/sf/index.ts",
      "import": "./src/aws/sf/index.ts",
      "default": "./dist/aws/sf/index.js"
    },
    "./lambda": {
      "types": "./src/lambda/index.ts",
      "import": "./src/lambda/index.ts",
      "default": "./dist/lambda/index.js"
    },
    "./lambda/middleware": {
      "types": "./src/lambda/middleware/index.ts",
      "import": "./src/lambda/middleware/index.ts",
      "default": "./dist/lambda/middleware/index.js"
    }
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "*",
    "@aws-sdk/client-kinesis": "*",
    "@aws-sdk/client-sfn": "*",
    "@aws-sdk/client-sqs": "*",
    "@megawin/shared": "workspace:*",
    "@middy/core": "^7.2.1",
    "zod": "^4.4.3"
  }
}
