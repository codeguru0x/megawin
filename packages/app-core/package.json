{
  "name": "@megawin/app-core",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    "./application/usecase": {
      "types": "./src/application/usecase/index.ts",
      "default": "./dist/application/usecase/index.js"
    },
    "./application/usecase/*": {
      "types": "./src/application/usecase/*.ts",
      "default": "./dist/application/usecase/*.js"
    },
    "./application/*": {
      "types": "./src/application/*.ts",
      "default": "./dist/application/*.js"
    },
    "./lambda": {
      "types": "./src/lambda/index.ts",
      "default": "./dist/lambda/index.js"
    },
    "./lambda/*": {
      "types": "./src/lambda/*.ts",
      "default": "./dist/lambda/*.js"
    },
    "./lambda/http": {
      "types": "./src/lambda/http/index.ts",
      "default": "./dist/lambda/http/index.js"
    },
    "./lambda/http/*": {
      "types": "./src/lambda/http/*.ts",
      "default": "./dist/lambda/http/*.js"
    },
    "./lambda/middleware": {
      "types": "./src/lambda/middleware/index.ts",
      "default": "./dist/lambda/middleware/index.js"
    },
    "./lambda/middleware/*": {
      "types": "./src/lambda/middleware/*.ts",
      "default": "./dist/lambda/middleware/*.js"
    }
  },
  "imports": {
    "#application/*": "./src/application/*",
    "#lambda/*": "./src/lambda/*",
    "#next/*": "./src/next/*"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.2.1",
    "typescript": "5.9.3",
    "vitest": "latest"
  },
  "dependencies": {
    "@middy/core": "^7.0.2",
    "zod": "^4.3.6"
  }
}
