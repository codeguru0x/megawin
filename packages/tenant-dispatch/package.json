{
  "name": "@megawin/tenant-dispatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centralized tenant dispatch (outbox pattern) — queue payout/refund/reversal orders, worker dispatches to tenant APIs with retry + backoff.",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "build:deps": "turbo build --filter=@megawin/tenant-dispatch^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts",
      "default": "./dist/entities/index.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./builders": {
      "types": "./src/builders/index.ts",
      "import": "./src/builders/index.ts",
      "default": "./dist/builders/index.js"
    },
    "./repos": {
      "types": "./src/infras/repos/index.ts",
      "import": "./src/infras/repos/index.ts",
      "default": "./dist/infras/repos/index.js"
    },
    "./use-cases/enqueue": {
      "types": "./src/use-cases/enqueue/index.ts",
      "import": "./src/use-cases/enqueue/index.ts",
      "default": "./dist/use-cases/enqueue/index.js"
    },
    "./use-cases/process": {
      "types": "./src/use-cases/process/index.ts",
      "import": "./src/use-cases/process/index.ts",
      "default": "./dist/use-cases/process/index.js"
    },
    "./use-cases/admin": {
      "types": "./src/use-cases/admin/index.ts",
      "import": "./src/use-cases/admin/index.ts",
      "default": "./dist/use-cases/admin/index.js"
    },
    "./shared/labels": {
      "types": "./src/shared/labels/index.ts",
      "import": "./src/shared/labels/index.ts",
      "default": "./dist/shared/labels/index.js"
    }
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/next": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "@megawin/worker-core": "workspace:*",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "next": "^16.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
