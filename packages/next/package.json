{
  "name": "@megawin/next",
  "version": "1.0.0",
  "type": "module",
  "description": "Next.js App Router v16 utilities – API route builder, REST client, standardized responses",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    }
  },
  "dependencies": {
    "@megawin/http-client": "workspace:*",
    "@megawin/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
