{
  "name": "@megawin/next",
  "version": "1.0.0",
  "type": "module",
  "description": "Next.js App Router v16 utilities – API route builder, REST client, standardized responses",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "dependencies": {
    "@megawin/shared": "workspace:*",
    "@megawin/http-client": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.8",
    "next": "^16.1.6",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "packageManager": "pnpm@10.29.3"
}
