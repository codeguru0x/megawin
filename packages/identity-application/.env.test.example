# ─── AWS Profile (ưu tiên dùng profile thay vì access key) ───
AWS_PROFILE=megawin-dev
AWS_REGION=ap-southeast-1

# ─── Cognito – Workforce pool (company + agent) ───
COGNITO_WORKFORCE_USERPOOL_ID=ap-southeast-1_XXXXXXXXX

# ─── Cognito – Player pool (per-tenant players) ───
COGNITO_PLAYER_USERPOOL_ID=ap-southeast-1_YYYYYYYYY

# ─── MongoDB ───
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── AWS Credentials (chỉ dùng nếu KHÔNG dùng AWS_PROFILE) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
