# ─── AWS Profile (ưu tiên dùng profile thay vì access key) ───
AWS_PROFILE=megawin-dev
AWS_REGION=ap-southeast-1

# ─── Cognito – Workforce pool (company + agent) ───
COGNITO_WORKFORCE_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_WORKFORCE_CLIENT_ID=222222222222222222222222

# ─── Cognito – Player pool (per-tenant players) ───
COGNITO_PLAYER_POOL_ID=ap-southeast-1_YYYYYYYYY
COGNITO_PLAYER_POOL_CLIENT_ID=111111111111111111111111

# ─── Player Password Secret (HMAC key cho deterministic password) ───
PLAYER_PASSWORD_SECRET=replace-with-a-random-string-at-least-32-chars

# ─── MongoDB ───
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── AWS Credentials (chỉ dùng nếu KHÔNG dùng AWS_PROFILE) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
