{
  "name": "@megawin/ops-docs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Hệ thống tài liệu vận hành: bản developer (SSOT, không hiển thị backoffice) + bản staff (render trong backoffice).",
  "exports": {
    "./manifest": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
