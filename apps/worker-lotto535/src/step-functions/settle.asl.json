{
  "Comment": "Lotto 5/35 Settle Step Function – Kết sổ kỳ quay (crash-safe)",
  "QueryLanguage": "JSONata",
  "StartAt": "PrepareSettle",
  "States": {
    "PrepareSettle": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-prepare",
      "Assign": {
        "settleCtx": "{% $states.result %}"
      },
      "Next": "SettleEntries",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "SettleEntries": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-entries",
      "Arguments": "{% $settleCtx %}",
      "Assign": {
        "settleResult": "{% $states.result %}"
      },
      "Next": "CheckSettleDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "CheckSettleDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $settleResult.done %}",
          "Next": "CalculateFinancials"
        }
      ],
      "Default": "SettleEntries"
    },
    "CalculateFinancials": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-calculate-financials",
      "Arguments": "{% $settleCtx %}",
      "Assign": {
        "settleCtx": "{% $merge([$settleCtx, { 'financials': $states.result }]) %}"
      },
      "Next": "CheckPrizeRoute",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "CheckPrizeRoute": {
      "Type": "Choice",
      "Choices": [
        {
          "Comment": "Có jackpot winner → patch jackpot prize vào entries + lines",
          "Condition": "{% $settleCtx.financials.hasJackpotWinner %}",
          "Next": "PatchJackpotPrize"
        },
        {
          "Comment": "Split cycle có winner tier1-tier5 → patch split bonus vào entries",
          "Condition": "{% $settleCtx.financials.splitDetails != null %}",
          "Next": "ApplySplitBonuses"
        }
      ],
      "Default": "SyncTicketSummaries"
    },
    "PatchJackpotPrize": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-patch-jackpot-prize",
      "Arguments": "{% $settleCtx %}",
      "Assign": {
        "settleCtx": "{% $merge([$settleCtx, { 'jackpotWinners': $states.result.winners }]) %}"
      },
      "Next": "SyncTicketSummaries",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "ApplySplitBonuses": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-apply-split-bonuses",
      "Arguments": "{% $settleCtx %}",
      "Next": "SyncTicketSummaries",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "SyncTicketSummaries": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-sync-ticket-summaries",
      "Arguments": "{% $settleCtx %}",
      "Assign": {
        "syncResult": "{% $states.result %}"
      },
      "Next": "CheckSyncDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "CheckSyncDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $syncResult.done %}",
          "Next": "BuildSettleReport"
        }
      ],
      "Default": "SyncTicketSummaries"
    },
    "BuildSettleReport": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-build-settle-report",
      "Arguments": "{% $settleCtx %}",
      "Next": "PublishSettleDaily",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "PublishSettleDaily": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-publish-settle-daily",
      "Arguments": "{% $settleCtx %}",
      "Next": "FinalizeSettle",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "FinalizeSettle": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-finalize",
      "Arguments": "{% $settleCtx %}",
      "Next": "DispatchPayouts",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "DispatchPayouts": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-lotto535-dev-settle-dispatch-payouts",
      "Arguments": "{% $settleCtx %}",
      "Assign": {
        "payoutResult": "{% $states.result %}"
      },
      "Next": "CheckPayoutDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PayoutFailed"
        }
      ]
    },
    "CheckPayoutDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $payoutResult.done %}",
          "Next": "PayoutComplete"
        }
      ],
      "Default": "PayoutWait"
    },
    "PayoutWait": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "DispatchPayouts"
    },
    "PayoutComplete": {
      "Type": "Pass",
      "End": true
    },
    "PayoutFailed": {
      "Type": "Pass",
      "Comment": "Payout error – settle vẫn hoàn tất, admin retry thủ công",
      "End": true
    }
  }
}
