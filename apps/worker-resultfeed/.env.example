# ─── Environment Variables ───
# SFv4 tự động load file .env theo stage:
#   - .env          → mặc định (local dev)
#   - .env.{stage}  → deploy (dev, prod)
#   - .env.local    → override local (gitignore)
#
# Ưu tiên: .env.{stage} > .env > .env.local (process env)
# Tất cả biến dưới đây được inject vào Lambda qua provider.environment

# ─── Database ───
MONGODB_URI=mongodb://localhost:27017/megawin-resultfeed

# ─── Fetch Providers (xem 02-fetch-parse.plan.md §5.4, §5.5) ───
# Oxylabs Web Unblocker — API user/pass RIÊNG của Web Unblocker (Dashboard → Web
# Unblocker → Users), KHÔNG phải login dashboard.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# context.dev — API key (Dashboard → API Keys). Dùng cho endpoint Scrape HTML
# (GET /v1/web/scrape/html), KHÔNG dùng Markdown/Extract.
CONTEXT_DEV_API_KEY=

# ─── Consensus (xem 03-consensus.plan.md §6.1) ───
# Testing-only override: máy tự set publishedAt ngay khi state=Agreed (không chờ
# HumanVerified). MẶC ĐỊNH tắt (false/không set) = đúng hành vi production (§6).
# PHẢI tắt trước khi core bắt đầu PULL resultfeed để settle tiền thật.
RESULTFEED_AUTO_PUBLISH_UNVERIFIED=false
