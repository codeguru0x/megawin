{
  "name": "@megawin/api-tenant",
  "version": "1.0.0",
  "description": "Tenant backoffice API (serverless Lambda + API Gateway)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "pnpm build:deps && node scripts/dev.mjs && serverless offline start --stage local",
    "build:deps": "turbo run build --filter=@megawin/api-tenant^...",
    "dev:token": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "deploy:dev": "pnpm build:deps && set -a && . ./.env.dev && set +a && serverless deploy --stage dev",
    "deploy:prod": "pnpm build:deps && set -a && . ./.env.prod && set +a && serverless deploy --stage prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/auth": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/game-core-application": "workspace:*",
    "@megawin/identity-application": "workspace:*",
    "@megawin/identity": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@middy/core": "^7.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.3.3",
    "serverless-offline": "^14.5.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "latest"
  }
}
