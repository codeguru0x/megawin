# Copy sang .env và điền giá trị thực
# serverless-offline đọc .env tự động

MONGODB_URI=mongodb://localhost:27017/megawin

# Cognito — format issuer: https://cognito-idp.{region}.amazonaws.com/{poolId}
COGNITO_ISSUER_URL=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS — mặc định * cho dev, production nên restrict
CORS_ALLOWED_ORIGIN=*
