# ─── Environment Variables ───
# SFv4 tự động load file .env theo stage:
#   - .env          → mặc định (local dev)
#   - .env.{stage}  → deploy (dev, prod)
#   - .env.local    → override local (gitignore)
#
# Ưu tiên: .env.{stage} > .env > .env.local (process env)
# Tất cả biến dưới đây được inject vào Lambda qua provider.environment

# ─── Database ───
MONGODB_URI=mongodb://localhost:27017/megawin

# ─── Cognito ───
# Format issuer: https://cognito-idp.{region}.amazonaws.com/{poolId}
COGNITO_PLAYER_POOL_ID=ap-southeast-1_XXXXXXXXX

COGNITO_PLAYER_POOL_ISSUER_URL=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX
COGNITO_PLAYER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ───
# Mặc định * cho dev, production nên restrict domain cụ thể
CORS_ALLOWED_ORIGIN=*
