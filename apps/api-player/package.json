{
  "name": "@megawin/api-player",
  "version": "1.0.0",
  "description": "Player-facing game API (serverless Lambda + API Gateway)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node scripts/dev.mjs && serverless offline start --stage local",
    "build:deps": "turbo run build --filter=@megawin/api-player^...",
    "dev:token": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "deploy:dev": "pnpm build:deps && set -a && . ./.env.dev && set +a && serverless deploy --stage dev",
    "deploy:prod": "pnpm build:deps && set -a && . ./.env.prod && set +a && serverless deploy --stage prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/auth": "workspace:*",
    "@megawin/game-bingo18": "workspace:*",
    "@megawin/game-bingo18-application": "workspace:*",
    "@megawin/game-core": "workspace:*",
    "@megawin/game-keno": "workspace:*",
    "@megawin/game-keno-application": "workspace:*",
    "@megawin/game-lotto535": "workspace:*",
    "@megawin/game-lotto535-application": "workspace:*",
    "@megawin/game-max3d": "workspace:*",
    "@megawin/game-max3d-application": "workspace:*",
    "@megawin/game-max3dpro": "workspace:*",
    "@megawin/game-max3dpro-application": "workspace:*",
    "@megawin/game-mega645": "workspace:*",
    "@megawin/game-mega645-application": "workspace:*",
    "@megawin/game-power655": "workspace:*",
    "@megawin/game-power655-application": "workspace:*",
    "@megawin/identity": "workspace:*",
    "@megawin/identity-application": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "@middy/core": "^7.7.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@types/node": "^25.9.4",
    "serverless-offline": "^14.7.3",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
