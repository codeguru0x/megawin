{
  "Comment": "Mega 6/45 Void Draw Step Function – Huỷ kỳ quay (crash-safe)",
  "QueryLanguage": "JSONata",
  "StartAt": "PrepareVoid",
  "States": {
    "PrepareVoid": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-prepare:$LATEST",
      "Assign": {
        "voidCtx": "{% $states.result %}"
      },
      "Next": "VoidEntries",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "VoidEntries": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-entries:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Assign": {
        "voidResult": "{% $states.result %}"
      },
      "Next": "CheckVoidDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "CheckVoidDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $voidResult.done %}",
          "Next": "SyncTicketSummaries"
        }
      ],
      "Default": "VoidEntries"
    },
    "SyncTicketSummaries": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-sync-ticket-summaries:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Assign": {
        "syncResult": "{% $states.result %}"
      },
      "Next": "CheckSyncDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "CheckSyncDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $syncResult.done %}",
          "Next": "BuildVoidReport"
        }
      ],
      "Default": "SyncTicketSummaries"
    },
    "BuildVoidReport": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-build-void-report:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Next": "PublishSettleDaily",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "PublishSettleDaily": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-publish-settle-daily:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Next": "PublishPlayerDaily",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "PublishPlayerDaily": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-publish-player-daily:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Next": "FinalizeVoid",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "FinalizeVoid": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-finalize:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Next": "EnqueueDispatchRefunds",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "EnqueueDispatchRefunds": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:YOUR_ACCOUNT_ID:function:mw-worker-mega645-dev-void-enqueue-dispatch-refunds:$LATEST",
      "Arguments": "{% $voidCtx %}",
      "Assign": {
        "enqueueResult": "{% $states.result %}"
      },
      "Next": "CheckEnqueueDone",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 10,
          "BackoffRate": 2,
          "MaxDelaySeconds": 120,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EnqueueRetryWait"
        }
      ]
    },
    "CheckEnqueueDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $enqueueResult.done %}",
          "Next": "VoidSucceeded"
        }
      ],
      "Default": "EnqueueDispatchRefunds"
    },
    "VoidSucceeded": {
      "Type": "Succeed"
    },
    "EnqueueRetryWait": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "EnqueueDispatchRefunds"
    }
  }
}
