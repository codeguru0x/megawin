{
  "name": "@megawin/worker-tenant-dispatch",
  "version": "1.0.0",
  "private": true,
  "description": "Tenant dispatch worker — polls tenant_dispatch_orders outbox, calls tenant batchTransaction API with retry/backoff.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build:deps": "turbo run build --filter=@megawin/worker-tenant-dispatch^...",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "deploy:dev": "pnpm build:deps && set -a && . ./.env.dev && set +a && serverless deploy --stage dev",
    "deploy:prod": "pnpm build:deps && set -a && . ./.env.prod && set +a && serverless deploy --stage prod",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@megawin/app-core": "workspace:*",
    "@megawin/data": "workspace:*",
    "@megawin/shared": "workspace:*",
    "@megawin/tenant-dispatch": "workspace:*",
    "@megawin/tenant-gateway": "workspace:*",
    "@megawin/worker-core": "workspace:*"
  },
  "devDependencies": {
    "@megawin/typescript-config": "workspace:*",
    "@megawin/vitest-config": "workspace:*",
    "@types/node": "^25.9.6",
    "next": "^16.3.5",
    "serverless-offline": "^14.7.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
