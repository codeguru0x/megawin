{
  "extends": "@megawin/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "vitest.config.ts"]
}
