# ─── AWS Credentials (chỉ dùng nếu KHÔNG dùng AWS_PROFILE) ───
AWS_ACCESS_KEY_ID=AKIA321321321321321321
AWS_SECRET_ACCESS_KEY=3213213213213213213213213213213213213213213213213213213213213213
AWS_REGION=ap-southeast-1
# ============ Better Auth ============
# Secret key for signing sessions/tokens (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here 
BETTER_AUTH_URL=http://localhost:3000

# ============ Database ============
MONGODB_URI=mongodb://localhost:27017/megawin
REDIS_URI=redis://localhost:6379

# ============ AWS Cognito Workforce ============ 
COGNITO_WORKFORCE_CLIENT_ID=your-cognito-client-id
COGNITO_WORKFORCE_DOMAIN=your-app.auth.ap-southeast-1.amazoncognito.com
COGNITO_WORKFORCE_REGION=ap-southeast-1
COGNITO_WORKFORCE_POOL_ID=ap-southeast-1_xxxxxxxxx

# ============ Cognito Player ============
COGNITO_PLAYER_POOL_ID=ap-southeast-1_xxxxxxxxx

# Site URL for API client (used on client-side)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# dùng 3 giá trị: "development" (local dev), "staging" (Cty test), "production"
NEXT_PUBLIC_APP_ENV=development

