POWER655_SETTLE_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:Power655SettleStateMachine
MAX3D_SETTLE_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:Max3dSettleStateMachine
MAX3DPRO_SETTLE_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:Max3dproSettleStateMachine

# ============ Step Function ARNs – Void ============
KENO_VOID_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:KenoVoidStateMachine
