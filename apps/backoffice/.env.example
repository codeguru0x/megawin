# ─── AWS Credentials (chỉ dùng nếu KHÔNG dùng AWS_PROFILE) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============ Better Auth ============
# Secret key for signing sessions/tokens (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here

# Base URL of the application
BETTER_AUTH_URL=http://localhost:3000

# ============ Database ============
MONGODB_URI=mongodb://localhost:27017/megawin
REDIS_URI=redis://localhost:6379


# ============ AWS Cognito Workforce ============ 
COGNITO_WORKFORCE_CLIENT_ID=your-cognito-client-id
COGNITO_WORKFORCE_CLIENT_SECRET=your-cognito-client-secret
COGNITO_WORKFORCE_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
COGNITO_WORKFORCE_REGION=us-east-1
COGNITO_WORKFORCE_POOL_ID=us-east-1_xxxxxxxxx

# ============ Cognito Player ============
COGNITO_PLAYER_POOL_ID=us-east-1_xxxxxxxxx

# Site URL for API client (used on client-side)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
 
 
# ============ Step Function ARNs – Settle ============
KENO_SETTLE_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:KenoSettleStateMachine
BINGO18_SETTLE_SFN_ARN=arn:aws:states:ap-southeast-1:123456789:stateMachine:Bingo18SettleStateMachine
