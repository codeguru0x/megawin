## 6. entryMirrors — Source of Truth

### Schema

```typescript
interface EntryMirror {
  _id: string;                      // = entryId từ Megawin
  version: string;                  // cursor từ Megawin feed

  // ─── Từ Megawin feed (giữ nguyên) ───
  gameProduct: string;
  ticketId: string;
  ticketNo: string;
  accountId: string;
  username: string;
  drawId: string;
  financialDate: string;            // "YYYY-MM-DD"
  status: "scheduled" | "settled" | "void";
  outcome?: "win" | "loss" | "void";

  stakeAmount: number;
  winAmount: number;
  payoutAmount: number;
  ggr: number;
  commissionRate: number;
  commissionAmount: number;

  betContent: unknown;
  drawResult?: unknown;
  payoutDetail?: unknown;
  voidInfo?: { originalAmount: number; refundAmount: number; voidedAt: Date };

  createdAt: Date;
  updatedAt: Date;

  // ─── Tenant enrich + Commission splits (fixed fields) ───
  agentPath: string[];              // ["C1", "M1", "S1", "MA1", "A1"]

  company:  AgentSplit;
  manager:  AgentSplit;
  super:    AgentSplit;
  master:   AgentSplit;
  agent:    AgentSplit;

  syncedAt: Date;
}
```

### Indexes

```
{ version: 1 }                                             // poll cursor
{ drawId: 1 }                                              // rebuild per draw
{ "company.agentId": 1, financialDate: 1, status: 1 }     // company report
{ "manager.agentId": 1, financialDate: 1, status: 1 }     // manager report
{ "super.agentId": 1, financialDate: 1, status: 1 }       // super report
{ "master.agentId": 1, financialDate: 1, status: 1 }      // master report
{ "agent.agentId": 1, financialDate: 1, status: 1 }       // agent report
{ accountId: 1, financialDate: 1 }                         // player drill-down
```

