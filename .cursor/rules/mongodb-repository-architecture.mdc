  drawCount: number;
  entryCount: number;
  /** Tổng doanh thu bán vé (VND). */
  totalStake: number;
  /** Gross Gaming Revenue = totalStake - totalPayout (VND). */
  ggr: number;
}
```

```typescript
// ── repos/types/entry.types.ts ──────────────────────────────────────
/**
 * Aggregate players cho 1 draw × 1 tenant.
 * Kết quả $group by accountId. Dùng drill cấp 3 financial reports.
 */
export interface PlayerBreakdownRow {
  accountId: string;
  username: string;
  entryCount: number;
  totalStake: number;
  totalPayout: number;
}
```

