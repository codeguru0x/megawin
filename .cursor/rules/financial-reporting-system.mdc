```

### 3.4 VoidDrawReport

```typescript
/** Báo cáo kỳ quay đã void. 1 doc = 1 draw.
 * Nếu draw đã settle trước khi void, snapshot settle data vào previousSettleSnapshot.
 * IDEMPOTENT: upsert by drawId.
 * Thông tin draw (drawNo, drawDate) tra từ DrawDoc khi cần hiển thị. */
export interface VoidDrawReport {
  drawId: string;
  financialDate: string;

  entryCount: number;
  playerCount: number;
  tenantCount: number;

  /** Tổng tiền cược gốc trước khi hoàn (VND). */
  totalOriginalStake: number;
  /** Tổng tiền hoàn trả (VND). */
  totalRefundAmount: number;

  /** True nếu draw đã settle trước khi bị void. */
  wasPreviouslySettled: boolean;
  /** Snapshot settle data trước khi xoá. Chỉ có khi wasPreviouslySettled = true. */
  previousSettleSnapshot?: VoidPreviousSettleSnapshot;

  createdAt: Date;
  updatedAt: Date;
}

/** Snapshot dữ liệu settle trước khi void, dùng cho audit trail. */
export interface VoidPreviousSettleSnapshot {
  totalStake: number;
  totalPayout: number;
  ggr: number;
  totalCommission: number;
  netProfit: number;
}

// Unique index: { drawId: 1 }
// Query index:  { financialDate: 1 }
```

### 3.5 OutstandingDrawReport

```typescript
/** Snapshot số liệu entries chưa settle/void cho 1 draw active. TTL auto-expire.
 * Scheduled job upsert mỗi 5 phút, refresh snapshotAt.
 * Khi draw settle/void, job ngừng refresh -> doc tự expire sau 15 phút.
 * Thông tin draw (drawNo, drawDate, drawTime) tra từ DrawDoc khi cần hiển thị. */
export interface OutstandingDrawReport {
  drawId: string;
  financialDate: string;

  entryCount: number;
  playerCount: number;
  tenantCount: number;
  lineCount?: number;
  /** Tổng tiền cược pending (VND). */
  totalStake: number;
  /** Ước tính hoa hồng (VND). */
  estimatedCommission: number;

  /** TTL field. MongoDB tự xoá doc khi snapshotAt + 900s < now. */
  snapshotAt: Date;
  createdAt: Date;
  updatedAt: Date;
}

// Unique index: { drawId: 1 }
// TTL index:    { snapshotAt: 1 }, expireAfterSeconds: 900
```

### 3.6 System Report Interfaces

Đặt tại `packages/game-core/src/entities/financial-report.ts`.

```typescript
/** Tổng hợp settle của 1 game trong 1 ngày tài chính. Re-aggregate từ settle_draw_reports.
 * KHÔNG có system_settle_daily riêng. Daily total = aggregate collection này by financialDate. */
export interface SystemSettleGameDaily {
  /** Game product identifier. */
  gameProduct: GameProduct;
  /** Ngày tài chính (YYYY-MM-DD). */
  financialDate: string;

  drawCount: number;
  entryCount: number;
  playerCount: number;
  tenantCount: number;

  /** Tổng tiền cược (VND). */
  totalStake: number;
  /** Tổng tiền trả thưởng (VND). */
  totalPayout: number;
  /** GGR = totalStake - totalPayout. */
  ggr: number;
  /** Tổng hoa hồng đại lý (VND). */
  totalCommission: number;
  /** Lợi nhuận ròng (VND). ggr - totalCommission. Có thể ÂM. */
  netProfit: number;

  createdAt: Date;
  updatedAt: Date;
}
// Unique: { financialDate: 1, gameProduct: 1 }
// Query daily total: aggregate WHERE { financialDate } -> SUM all games

/** Tổng hợp settle cross-game của 1 tenant cho 1 game trong 1 ngày tài chính.
 * Flatten design: 1 doc = 1 financialDate x 1 tenantId x 1 gameProduct.
 * Tenant daily total = aggregate WHERE { financialDate, tenantId } -> SUM all games.
 * All tenants for 1 date = aggregate WHERE { financialDate } group by tenantId. */
export interface SystemSettleTenantDaily {
  /** Ngày tài chính (YYYY-MM-DD). */
  financialDate: string;
  /** ID đại lý. */
  tenantId: string;
  /** Game product identifier. */
  gameProduct: GameProduct;

  /** Tổng tiền cược (VND). */
  totalStake: number;
  /** Tổng tiền trả thưởng (VND). */
  totalPayout: number;
  /** GGR = totalStake - totalPayout. */
  ggr: number;
  /** Hoa hồng đại lý (VND). */
  commission: number;
  /** Lợi nhuận ròng (VND). ggr - commission. */
  netProfit: number;
  entryCount: number;
  /** Số player (unique accountId) của tenant trong ngày. */
  playerCount: number;
  drawCount: number;

  createdAt: Date;
  updatedAt: Date;
}
// Unique: { financialDate: 1, tenantId: 1, gameProduct: 1 }

/** Snapshot outstanding cross-draw cho 1 game. TTL auto-expire. */
export interface SystemOutstandingGameDaily {
  gameProduct: GameProduct;

  activeDrawCount: number;
  totalEntryCount: number;
  /** Tổng số player (unique accountId) pending. */
  totalPlayerCount: number;
  /** Tổng số tenant tham gia pending. */
  totalTenantCount: number;
  totalOutstandingStake: number;
  totalEstimatedCommission: number;

  /** TTL field. */
  snapshotAt: Date;
  updatedAt: Date;
}
// Unique: { gameProduct: 1 }
// TTL:    { snapshotAt: 1 }, expireAfterSeconds: 900
```

**LƯU Ý QUAN TRỌNG**:
- **KHÔNG có `SystemSettleDaily`** riêng. Khi cần daily total, aggregate `system_settle_game_daily` WHERE {financialDate}.
- **KHÔNG có `SystemTenantGameBreakdown`** hay `SystemDailyGameBreakdown`** nested array. Tất cả đã flatten.
- **KHÔNG có `system_settle_daily`** collection. Chỉ còn 3 system collections.

