{
  "name": "megawin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci": "biome ci .",
    "format:docs": "prettier --write \"**/*.{md,yml,yaml}\"",
    "format:docs:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "graph:status": "gitnexus status",
    "graph:sync": "gitnexus analyze",
    "graph:watch": "gitnexus analyze --watch --debounce 4000",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"],
    "*.{md,yml,yaml}": ["prettier --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0"
}
