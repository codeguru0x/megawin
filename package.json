{
  "name": "megawin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "oxlint . && prettier --check .",
    "graph:status": "gitnexus status",
    "graph:sync": "gitnexus analyze",
    "graph:watch": "gitnexus analyze --watch --debounce 4000",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,jsonc,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs}": [
      "oxlint --fix"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@shadcn/lint": "0.1.0",
    "@typescript/typescript6": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0"
}
